# Copy to .env for local runs (`pnpm dev:live`) and set the same names in the
# Vercel project (Settings → Environment Variables). Never commit .env.

# MongoDB Atlas connection string (Database → Connect → Drivers).
# Leave unset locally to use a throwaway in-memory MongoDB.
MONGODB_URI=
# Database name inside the cluster.
MONGODB_DB=binsight

# Ably API key with publish + subscribe capability (Ably dashboard → API Keys).
# Stays on the server: browsers get short-lived subscribe-only tokens.
# Leave unset locally to use the dev server's in-process bus instead.
ABLY_API_KEY=

# The operator password for the Live panel (start/stop, speed, chaos, reset).
OPERATOR_PASSWORD=

# Signs the operator session cookie and phone ids. Use 32+ random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: fire alerts are POSTed here as JSON ({ "text": ... }), e.g. a Slack,
# Discord or Zapier/Make webhook that emails you.
ALERT_WEBHOOK_URL=

# Optional: Vercel sends this as a bearer token on its cron calls; set it so
# nobody else can trigger /api/cron.
CRON_SECRET=

# The city name used in channel names and documents.
CITY=demo
