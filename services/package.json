{
  "name": "@binsight/services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/dev-server.ts",
    "build": "esbuild src/vercel.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --external:mongodb --external:ably --external:@vercel/functions --log-level=warning",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@binsight/core": "workspace:*",
    "@vercel/functions": "^3.10.3",
    "ably": "^2.30.0",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
