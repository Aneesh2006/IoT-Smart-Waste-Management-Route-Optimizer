{
  "name": "@binsight/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth --quiet",
    "deploy": "pnpm --filter @binsight/web build && cdk deploy --require-approval never --outputs-file ../apps/web/public/live-config.raw.json && node scripts/write-live-config.mjs",
    "diff": "cdk diff",
    "destroy": "cdk destroy"
  },
  "devDependencies": {
    "@binsight/services": "workspace:*",
    "@types/node": "^24.0.0",
    "aws-cdk": "^2.1146.1",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
